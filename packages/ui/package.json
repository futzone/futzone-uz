{
  "name": "@futzone/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./components/*": { "types": "./dist/components/*.d.ts", "import": "./dist/components/*.js" },
    "./lib/utils": { "types": "./dist/lib/utils.d.ts", "import": "./dist/lib/utils.js" }
  },
  "scripts": {
    "build": "tsup src/index.ts src/components/*.tsx src/lib/*.ts --format esm --dts --clean",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": { "react": "^19.1.1", "react-dom": "^19.1.1" },
  "devDependencies": {
    "@futzone/config": "workspace:*",
    "@types/react": "^19.1.9",
    "eslint": "^9.32.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
