# App ports are env-overridable: WEB_PORT in apps/web, API_PORT in apps/api, and ADMIN_PORT here.
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-maps-api-key
SENTRY_DSN=
LOG_LEVEL=debug
NODE_ENV=development
