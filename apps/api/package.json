{
  "name": "@futzone/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "pnpm run prisma:generate",
    "dev": "nest start --watch",
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build && node -e \"const fs=require('node:fs');fs.accessSync('dist/main.js');fs.accessSync('dist/generated/prisma/index.js')\"",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma --max-warnings 0",
    "pretypecheck": "pnpm run prisma:generate",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run prisma:generate",
    "test": "jest --config jest.config.js",
    "pretest:e2e": "pnpm run prisma:generate",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:perf": "jest --config test/jest-perf.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:generate-search-perf": "ts-node prisma/generate-search-perf.ts",
    "db:reset": "node scripts/db-reset.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@futzone/contracts": "workspace:*",
    "@futzone/i18n": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.5",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "nestjs-pino": "^4.4.1",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@futzone/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.32.0",
    "jest": "^30.1.3",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
