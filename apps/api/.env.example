# Local development defaults only. Replace all secrets outside local development.
DATABASE_URL=postgresql://futzone:futzone_dev_password@localhost:5432/futzone?schema=public
TEST_DATABASE_URL=postgresql://futzone:futzone_dev_password@localhost:5432/futzone_test?schema=public
REDIS_URL=redis://localhost:6380
BULLMQ_PREFIX=bull
ATTENDANCE_EARLY_CANCEL_HOURS=6
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=futzone-avatars
S3_ACCESS_KEY=futzone
S3_SECRET_KEY=futzone_dev_password
S3_REGION=us-east-1

SMS_PROVIDER=mock
MOCK_SMS_URL=http://localhost:4010
ESKIZ_EMAIL=placeholder@example.com
ESKIZ_PASSWORD=replace-with-eskiz-password
ESKIZ_FROM=4546

API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=replace-with-yandex-maps-api-key
SENTRY_DSN=
# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@futzone.uz
LOG_LEVEL=debug
NODE_ENV=development

MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
